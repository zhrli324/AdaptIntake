# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI-compatible chat endpoint
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-key-here

# Model used by each role
AGENT_MODEL=deepseek-flash
PATIENT_MODEL=deepseek-flash
JUDGE_MODEL=deepseek-flash

# Optional per-role endpoint overrides (leave empty to use LLM_BASE_URL / LLM_API_KEY)
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Optional: sampling temperature (leave empty for models that do not accept it)
LLM_TEMPERATURE=
# "json_object" asks the endpoint for JSON output; "prompt" relies on instructions only
LLM_JSON_MODE=json_object
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
