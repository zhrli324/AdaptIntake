# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI-compatible endpoint (official API or a relay/proxy service)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-key-here

# Model used by each role. The judge should come from a different model family than the agent.
AGENT_MODEL=gpt-5.6
PATIENT_MODEL=gpt-5.6
JUDGE_MODEL=claude-sonnet-5-5

# Optional per-role endpoint overrides (leave empty to use LLM_BASE_URL / LLM_API_KEY)
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Optional: sampling temperature (leave empty for models that do not accept it, e.g. reasoning models)
LLM_TEMPERATURE=
# JSON mode: "json_object" asks the endpoint for JSON output; "prompt" relies on instructions only
LLM_JSON_MODE=json_object
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
