 "system": "adaptintake",
 "transcript": [
  {
   "role": "agent",
   "text": "Hello, I'm here to help you get ready for your appointment. Could you tell me what has been bothering you?"
  },
  {
   "role": "patient",
   "text": "Both knees hurt."
  },
  {
   "role": "agent",
   "text": "Can you tell me when your knee pain started, how it came on, and whether you have any allergies to medicines?"
  },
  {
   "role": "patient",
   "text": "Several years now. Worse these last few months."
  },
  {
   "role": "agent",
   "text": "How is this affecting your day-to-day life, and could you tell me about any medicines you take — including anything new or changed recently?"
  },
  {
   "role": "patient",
   "text": "Hard to get around, the stairs especially."
  },
  {
   "role": "agent",
   "text": "Can you tell me about your past health, like any ongoing health issues, past illnesses, operations, or hospital stays?"
  },
  {
   "role": "patient",
   "text": "My wife had a hip done years ago, she did well."
  },
  {
   "role": "agent",
   "text": "Have you ever had an allergy or a bad reaction to any medicine — yes, no, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "No, nothing like that."
  },
  {
   "role": "agent",
   "text": "How bad is the pain in your knees — would you say it’s mild, medium, or severe, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "Pretty bad. Keeps me from doing much."
  },
  {
   "role": "agent",
   "text": "Has anything else come along with your knee problem?"
  },
  {
   "role": "patient",
   "text": "No, just the knees."
  },
  {
   "role": "agent",
   "text": "Are you taking any medicines at the moment — none at all, just one or two, or three or more — or are you not sure?"
  },
  {
   "role": "patient",
   "text": "I take anti-inflammatories for the knees."
  },
  {
   "role": "agent",
   "text": "Have you had other long-term health problems — none, one, or a few, or not sure?"
  },
  {
   "role": "patient",
   "text": "No, nothing else long-term."
  },
  {
   "role": "agent",
   "text": "Do any activities make your knee pain better or worse?"
  },
  {
   "role": "patient",
   "text": "Haven't really noticed anything like that."
  },
  {
   "role": "agent",
   "text": "What worries you most about your knees?"
  },
  {
   "role": "patient",
   "text": "Wondering if surgery would help."
  },
  {
   "role": "agent",
   "text": "Would you say your knee pain is mild, moderate, or severe — or you're not sure?"
  },
  {
   "role": "patient",
   "text": "Pretty bad most days."
  },
  {
   "role": "agent",
   "text": "Is your knee pain there all the time, or does it come and go?"
  },
  {
   "role": "patient",
   "text": "My son keeps telling me to get it seen to."
  },
  {
   "role": "agent",
   "text": "Thank you, that is very helpful. I have put together a short summary of what you told me. Please read it and tell me if anything should be corrected before it goes to your doctor."
  }
 ],
