 "system": "adaptintake",
 "transcript": [
  {
   "role": "agent",
   "text": "Hello, I'm here to help you get ready for your appointment. Could you tell me what has been bothering you?"
  },
  {
   "role": "patient",
   "text": "Pain in my left flank."
  },
  {
   "role": "agent",
   "text": "Could you tell me when the pain in your left flank started, how it came on, and whether you have any allergies?"
  },
  {
   "role": "patient",
   "text": "Started about four, five days ago."
  },
  {
   "role": "agent",
   "text": "How is this pain affecting your daily life, and what medicines are you taking at the moment, including any new or changed ones?"
  },
  {
   "role": "patient",
   "text": "My daughter keeps telling me to get it checked."
  },
  {
   "role": "agent",
   "text": "Do you have any allergies or bad reactions to medicines — would you say no, yes, or you're not sure?"
  },
  {
   "role": "patient",
   "text": "No, I haven't noticed any allergies."
  },
  {
   "role": "agent",
   "text": "Before this started, have you had any other health problems that you've seen a doctor about?"
  },
  {
   "role": "patient",
   "text": "Another doctor told me I have a kidney stone."
  },
  {
   "role": "agent",
   "text": "How bad is the pain — would you say it's mild, moderate, or severe, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "I couldn't say really."
  },
  {
   "role": "agent",
   "text": "Besides the pain in your left flank, have you noticed anything else that feels different or new?"
  },
  {
   "role": "patient",
   "text": "I've been feeling sick to my stomach."
  },
  {
   "role": "agent",
   "text": "Are you taking any medicines at the moment — either ones you take regularly or something you've started recently — or are you not sure?"
  },
  {
   "role": "patient",
   "text": "My son used to take tablets for his back."
  },
  {
   "role": "agent",
   "text": "Is there anything that makes the pain better or worse?"
  },
  {
   "role": "patient",
   "text": "I haven't noticed anything making it better or worse."
  },
  {
   "role": "agent",
   "text": "Does the pain stay with you all the time, or does it come and go?"
  },
  {
   "role": "patient",
   "text": "I haven't really noticed, it just hurts."
  },
  {
   "role": "agent",
   "text": "Do you take any medicines yourself — ones you take every day, ones you only take now and then, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "No, I don't take anything regularly."
  },
  {
   "role": "agent",
   "text": "Can you tell me what the pain feels like?"
  },
  {
   "role": "patient",
   "text": "It just hurts, I can't describe it better."
  },
  {
   "role": "agent",
   "text": "Has this pain changed how you sleep at night?"
  },
  {
   "role": "patient",
   "text": "No, I haven't noticed any trouble sleeping."
  },
  {
   "role": "agent",
   "text": "Besides the kidney stone you mentioned, is there anything else about your past health — like other conditions, illnesses, or operations — that you think I should know about?"
  },
  {
   "role": "patient",
   "text": "No, nothing else I can think of."
  },
  {
   "role": "agent",
   "text": "Besides feeling sick to your stomach, is there anything else you’ve noticed that you want to mention?"
  },
  {
   "role": "patient",
   "text": "My grandson just started school, you know."
  },
  {
   "role": "agent",
   "text": "Besides feeling sick to your stomach, is there anything else you'd like to add?"
  },
  {
   "role": "patient",
   "text": "I've been vomiting too."
  },
  {
   "role": "agent",
   "text": "Thank you, that is very helpful. I have put together a short summary of what you told me. Please read it and tell me if anything should be corrected before it goes to your doctor."
  }
 ],
