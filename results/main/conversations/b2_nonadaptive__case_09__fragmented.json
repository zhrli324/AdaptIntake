 "system": "b2_nonadaptive",
 "transcript": [
  {
   "role": "agent",
   "text": "Hello, I'm here to help you get ready for your appointment. Could you tell me what has been bothering you?"
  },
  {
   "role": "patient",
   "text": "My lower back's been hurting."
  },
  {
   "role": "agent",
   "text": "Can you tell me when your lower back pain first started?"
  },
  {
   "role": "patient",
   "text": "About ten days ago."
  },
  {
   "role": "agent",
   "text": "Do you have any allergies to medicines, or have you ever had a bad reaction to one?"
  },
  {
   "role": "patient",
   "text": "My wife keeps track of that sort of thing."
  },
  {
   "role": "agent",
   "text": "How bad is your lower back pain on a typical day?"
  },
  {
   "role": "patient",
   "text": "About six out of ten."
  },
  {
   "role": "agent",
   "text": "Do you take any medicines regularly?"
  },
  {
   "role": "patient",
   "text": "I take metformin."
  },
  {
   "role": "agent",
   "text": "Have you ever had any operations?"
  },
  {
   "role": "patient",
   "text": "No, never had an operation."
  },
  {
   "role": "agent",
   "text": "Have you noticed any other symptoms along with your back pain?"
  },
  {
   "role": "patient",
   "text": "No trouble passing water, if that's what you mean."
  },
  {
   "role": "agent",
   "text": "Does anything make your lower back pain better or worse?"
  },
  {
   "role": "patient",
   "text": "Bending and getting out of the car make it worse."
  },
  {
   "role": "agent",
   "text": "Does your back pain come and go, or is it there all the time?"
  },
  {
   "role": "patient",
   "text": "A stiff ache most of the time."
  },
  {
   "role": "agent",
   "text": "What worries you most about your back pain?"
  },
  {
   "role": "patient",
   "text": "Wondering if I've slipped a disc."
  },
  {
   "role": "agent",
   "text": "Is there anything else you’d like to add about your past health?"
  },
  {
   "role": "patient",
   "text": "I had the same thing five years ago."
  },
  {
   "role": "agent",
   "text": "Is there anything else you'd like to add about your medicines?"
  },
  {
   "role": "patient",
   "text": "That reminds me, my son's a nurse up north."
  },
  {
   "role": "agent",
   "text": "Has your back pain been affecting your sleep at all?"
  },
  {
   "role": "patient",
   "text": "It eases if I lie on my side."
  },
  {
   "role": "agent",
   "text": "Is there anything else you've noticed along with your back pain?"
  },
  {
   "role": "patient",
   "text": "No numbness round the back passage or groin."
  },
  {
   "role": "agent",
   "text": "Is there anything else about your health in the past you'd like to add?"
  },
  {
   "role": "patient",
   "text": "I've got type 2 diabetes."
  },
  {
   "role": "agent",
   "text": "Besides the metformin, are there any other medicines you take regularly or have taken recently?"
  },
  {
   "role": "patient",
   "text": "Yes, gliclazide."
  },
  {
   "role": "agent",
   "text": "Has your back pain changed how you get around day to day — a lot, a little, not at all, or you're not sure?"
  },
  {
   "role": "patient",
   "text": "I can't do any gardening now."
  },
  {
   "role": "agent",
   "text": "Is there anything else you’ve noticed along with your back pain that we haven’t talked about yet?"
  },
  {
   "role": "patient",
   "text": "The physio sorted it out last time."
  },
  {
   "role": "agent",
   "text": "Thank you, that is very helpful. I have put together a short summary of what you told me. Please read it and tell me if anything should be corrected before it goes to your doctor."
  }
 ],
