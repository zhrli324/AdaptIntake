 "system": "b2_nonadaptive",
 "transcript": [
  {
   "role": "agent",
   "text": "Hello, I'm here to help you get ready for your appointment. Could you tell me what has been bothering you?"
  },
  {
   "role": "patient",
   "text": "A cough that won't go away."
  },
  {
   "role": "agent",
   "text": "When did you first notice this cough?"
  },
  {
   "role": "patient",
   "text": "My wife says I keep her awake at night."
  },
  {
   "role": "agent",
   "text": "Do you have any allergies?"
  },
  {
   "role": "patient",
   "text": "No, none that I know of."
  },
  {
   "role": "agent",
   "text": "How much does this cough bother you from day to day?"
  },
  {
   "role": "patient",
   "text": "It's about a 6 out of 10."
  },
  {
   "role": "agent",
   "text": "Did your cough start suddenly, come on gradually, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "Started about three weeks ago, after a cold."
  },
  {
   "role": "agent",
   "text": "What medicines have you taken in the last few weeks, if any?"
  },
  {
   "role": "patient",
   "text": "My blue inhaler, more often than usual lately."
  },
  {
   "role": "agent",
   "text": "Have you ever been told by a doctor that you have any long-term health conditions?"
  },
  {
   "role": "patient",
   "text": "I've had COPD for eight years."
  },
  {
   "role": "agent",
   "text": "Other than the cough, have you noticed any other new symptoms or changes in how you feel?"
  },
  {
   "role": "patient",
   "text": "My grandson just started university, you know."
  },
  {
   "role": "agent",
   "text": "Where in your body do you feel the cough most?"
  },
  {
   "role": "patient",
   "text": "Can't say really, it's just a chesty cough."
  },
  {
   "role": "agent",
   "text": "Is there anything that seems to make your cough better or worse?"
  },
  {
   "role": "patient",
   "text": "Cold air sets it off."
  },
  {
   "role": "agent",
   "text": "Have you noticed anything else going on along with the cough, or has it just been the cough, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "A bit more breathless than usual walking to the shop."
  },
  {
   "role": "agent",
   "text": "What, if anything, worries you about this cough?"
  },
  {
   "role": "patient",
   "text": "Worried my lungs are getting worse."
  },
  {
   "role": "agent",
   "text": "You mentioned your lung condition — is there anything else from your past health you’d like to add?"
  },
  {
   "role": "patient",
   "text": "I smoked for years. Stopped about ten years ago."
  },
  {
   "role": "agent",
   "text": "Is there anything else about your past health you'd like to add?"
  },
  {
   "role": "patient",
   "text": "I take a tablet for my blood pressure too."
  },
  {
   "role": "agent",
   "text": "Along with your cough and feeling more breathless than usual, is there anything else you’ve noticed?"
  },
  {
   "role": "patient",
   "text": "Bringing up more phlegm than usual for me."
  },
  {
   "role": "agent",
   "text": "Have you started any new medicines or changed any of your regular medicines recently, or are you not sure?"
  },
  {
   "role": "patient",
   "text": "No new ones. Fostair twice a day, same as always."
  },
  {
   "role": "agent",
   "text": "Thank you, that is very helpful. I have put together a short summary of what you told me. Please read it and tell me if anything should be corrected before it goes to your doctor."
  }
 ],
